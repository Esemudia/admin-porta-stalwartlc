# Stalwart Legal Admin Portal Environment Variables
# In production on Vercel, these default automatically to the live backend:
# VITE_API_URL=https://api.stalwartlc.com
# VITE_WS_URL=wss://api.stalwartlc.com/ws/chat

# If you use a staging backend or custom domain, set these in Vercel:
# Project Settings -> Environment Variables:
# VITE_API_URL=https://api.stalwartlc.com
# VITE_WS_URL=wss://api.stalwartlc.com/ws/chat
